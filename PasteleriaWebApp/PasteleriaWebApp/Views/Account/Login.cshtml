@{
    Layout = null; // Para que no cargue el menú arriba antes de loguearse
}

<!DOCTYPE html>
<html>
<head>
    <title>Login - Anderson Studio</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #f8f9fa; }
        .login-container { margin-top: 100px; max-width: 400px; }
    </style>
</head>
<body>
    <div class="container login-container">
        <div class="card shadow">
            <div class="card-body">
                <h2 class="text-center mb-4">Pastelería Web</h2>

                @if (ViewBag.Error != null)
                {
                        <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-group mb-3">
                        <label>Correo Electrónico</label>
                        <input type="email" name="correo" class="form-control" required placeholder="admin@pasteleria.com" />
                    </div>
                    <div class="form-group mb-3">
                        <label>Contraseña</label>
                        <input type="password" name="clave" class="form-control" required placeholder="********" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Ingresar</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>