@{
    Layout = null; // Para que no cargue el menú de arriba todavía
}

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login - Anderson Studio</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="bg-light d-flex align-items-center" style="height: 100vh;">

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-4">
                <div class="card shadow">
                    <div class="card-body">
                        <h3 class="text-center mb-4">Pastelería Login</h3>
                        
                        <form asp-action="Login" method="post">
                            <div class="mb-3">
                                <label class="form-label">Correo Electrónico</label>
                                <input type="email" name="correo" class="form-control" required placeholder="nombre@correo.com" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Contraseña</label>
                                <input type="password" name="clave" class="form-control" required placeholder="********" />
                            </div>

                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger p-2">@ViewBag.Error</div>
                            }

                            <button type="submit" class="btn btn-primary w-100">Ingresar al Sistema</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
